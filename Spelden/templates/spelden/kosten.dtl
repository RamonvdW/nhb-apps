{% extends 'design/site_layout.dtl' %}
{% comment %}
                Copyright (c) 2024-2026 Ramon van der Winkel.
                All rights reserved.
                Licensed under BSD-3-Clause-Clear. See LICENSE file for details.
{% endcomment %}
{% load static %}

{% block title %}Wat kosten de spelden?{% endblock %}

{% block pagina %}

    <!-- banner -->
    <div class="row center">
        <div class="col s12">
            <h1 class="sv-kopje-pagina">Wat kosten de spelden?</h1>
        </div>
    </div>

    <!-- blauw balk met wit informatie veld -->
    <div class="row-sv-blauw">
        <div class="col s12 m10 offset-m1 l8 offset-l2 xl6 offset-xl3">
            <div class="sv-kader">
                <table>
                    <thead>
                        <tr>
                            <th class="center">Speld</th>
                            <th class="center">Prijs per speld</th>
                            <th class="center">Prijs vervangende speld</th>
                        </tr>
                    </thead>

                    <tr>
                        <td class="center">Target award</td>
                        <td class="center">{{ prijs_wa_speld }}</td>
                        <td class="center">{{ prijs_vervang }}</td>
                    </tr>
                    <tr>
                        <td class="center">Sterspelden</td>
                        <td class="center">{{ prijs_wa_speld }}</td>
                        <td class="center">{{ prijs_vervang }}</td>
                    </tr>
                    <tr>
                        <td class="center">Arrowhead spelden</td>
                        <td class="center">{{ prijs_wa_speld }}</td>
                        <td class="center">{{ prijs_vervang }}</td>
                    </tr>
                    <tr>
                        <td class="center">Graadspeld</td>
                        <td class="center">{{ prijs_khsn_speld }}</td>
                        <td class="center">{{ prijs_vervang }}</td>
                    </tr>
                    <tr>
                        <td class="center">Meesterspeld</td>
                        <td class="center">{{ prijs_khsn_speld }}</td>
                        <td class="center">{{ prijs_vervang }}</td>
                    </tr>
                </table>

            </div>
        </div>
    </div>

    {% include 'feedback/sidebar.dtl' with op_pagina="spelden-kosten" %}

{% endblock %}
