{% extends 'design/site_layout.dtl' %}
{% comment %}
                Copyright (c) 2026 Ramon van der Winkel.
                All rights reserved.
                Licensed under BSD-3-Clause-Clear. See LICENSE file for details.
{% endcomment %}
{% load static %}
{% load design_knop %}

{% block title %}Bestelformulier{% endblock %}

{% block pagina %}

    <!-- banner -->
    <div class="row center">
        <div class="col s12">
            <h1 class="sv-kopje-pagina">Bestelformulier</h1>
            <p>Bestel prestatiespelden, voor jezelf</p>
        </div>
    </div>

    <!-- blauwe balk met informatie in tabel-vorm:  label - info -->
    <div class="row-sv-blauw">
        <div class="col s12 m10 offset-m1 l8 offset-l2">
            <table class="sv-kader-tabel">
                <tr>
                    <th>Sporter</th>
                    <td>{{ sporter_str }}</td>
                </tr>
                <tr>
                    <th>Wedstrijddiscipline</th>
                    <td>{{ discipline_str }}</td>
                </tr>
                {% if geslacht_str %}
                    <tr>
                        <th>Wedstrijdgeslacht</th>
                        <td>{{ geslacht_str }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>Gebruikte boog</th>
                    <td>{{ boogtype_str }}</td>
                </tr>
                <tr>
                    <th>Behaalde score</th>
                    <td>{{ score }}</td>
                </tr>
            </table>
        </div>
    </div>


    <!-- witruimte -->
    <div class="row center">
        <div class="col s12">
            <h2 class="sv-kopje-row">Stap 2</h2>
            <p>Vertel ons wat meer over de wedstrijd.</p>
        </div>
    </div>

    <!-- blauwe balk filters -->
    <div class="row-sv-blauw">

        <form action="{{ url_opslaan }}" method="post" onsubmit="document.getElementById('submit_knop').disabled=true; return true;">
            {% csrf_token %}

            <!-- filter: wedstrijddiscipline -->
            <div class="col s10 offset-s1 m6 offset-m3 l4 offset-l4 sv-kader-form">
                <div class="form-padding">

                    <table>
                        {% if doelen_opties %}
                            <tr>
                                <th>Aantal doelen</th>
                                <td>
                                    <ul id="id_doelen">
                                        {% for opt in doelen_opties %}
                                            <li>
                                                <label class="black-text" for="id_{{ opt.afkorting }}">
                                                    <input class="with-gap" type="radio" name="doelen" value="{{ opt.afkorting }}" required id="id_{{ opt.afkorting }}"{% if opt.actief %} checked{% endif %}>
                                                    <span>{{ opt.beschrijving }}</span>
                                                </label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </td>
                            </tr>
                        {% endif %}

                        {% if afstanden_opties %}
                            <tr>
                                <th>{{ afstanden_titel }}</th>
                                <td>
                                    <ul id="id_afstanden">
                                        {% for opt in afstanden_opties %}
                                            <li>
                                                <label class="black-text" for="id_{{ opt.afkorting }}">
                                                    <input class="with-gap" type="radio" name="afstand" value="{{ opt.afkorting }}" required id="id_{{ opt.afkorting }}"{% if opt.actief %} checked{% endif %}>
                                                    <span>{{ opt.beschrijving }}</span>
                                                </label>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </td>
                            </tr>
                        {% endif %}

                        <tr>
                            <td colspan="2" class="center">
                                <button class="btn-sv-rood" id="submit_knop" type="submit">Volgende stap</button>
                            </td>
                        </tr>

                    </table>

                </div>
            </div>

        </form>
    </div>


    <p class="center">
        {% sv-knop-nav url=url_stap1 icon='terug' tekst='Terug naar stap 1' kleur='blauw' %}
    </p>

    {% include 'feedback/sidebar.dtl' with op_pagina="spelden-bestel-stap2" %}

{% endblock %}
