{% extends 'design/site_layout.dtl' %}
{% comment %}
                Copyright (c) 2026 Ramon van der Winkel.
                All rights reserved.
                Licensed under BSD-3-Clause-Clear. See LICENSE file for details.
{% endcomment %}
{% load static %}
{% load design_knop %}

{% block title %}Bestelformulier, stap 3{% endblock %}

{% block pagina %}

    <!-- banner -->
    <div class="row center">
        <div class="col s12">
            <h1 class="sv-kopje-pagina">Bestelformulier</h1>
            <p>Bestel prestatiespelden, voor jezelf</p>
        </div>
    </div>

    <script>
        function wedstrijd_gekozen() {
            const el_inp_plaats = document.getElementById('invoer_plaats');
            const el_inp_land = document.getElementById('invoer_land');
            const el_select = document.getElementById('kies_wedstrijd');
            const gekozen = el_select.options[el_select.selectedIndex];
            el_inp_plaats.value = gekozen.dataset.plaats;
            el_inp_land.value = "Nederland";
        }
    </script>

    <!-- blauwe balk met informatie in tabel-vorm:  label - info -->
    <div class="row-sv-blauw">
        <div class="col s12 m10 offset-m1 l8 offset-l2">
            <table class="sv-kader-tabel">
                <tr>
                    <th>Sporter</th>
                    <td>{{ sporter_str }}</td>
                </tr>
                <tr>
                    <th>Wedstrijddiscipline</th>
                    <td>{{ discipline_str }}</td>
                </tr>
                {% if geslacht_str %}
                    <tr>
                        <th>Wedstrijdgeslacht</th>
                        <td>{{ geslacht_str }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>Gebruikte boog</th>
                    <td>{{ boogtype_str }}</td>
                </tr>
                <tr>
                    <th>Behaalde score</th>
                    <td>{{ score }}</td>
                </tr>
                <tr>
                    <th>Datum van de wedstrijd</th>
                    <td>{{ wedstrijd_datum }}</td>
                </tr>
            </table>
        </div>
    </div>


    <!-- witruimte -->
    <div class="row center">
        <div class="col s12">
            <h2 class="sv-kopje-row">Stap 3</h2>
            <p>Vertel ons wat meer over de wedstrijd</p>
        </div>
    </div>

    <!-- blauwe balk filters -->
    <div class="row-sv-blauw">

        <!-- filter: wedstrijddiscipline -->
        <div class="col s10 offset-s1 sv-kader-form">
            <div class="form-padding">
                <form action="{{ url_opslaan }}" method="post" onsubmit="document.getElementById('submit_knop').disabled=true; return true;">
                    {% csrf_token %}

                    <table>
                        <tr>
                            <th>Kies uit deze wedstrijden:</th>
                            <td>
                                <ul id="id_wedstrijden">
                                    {% for obj in kalender_lijst %}
                                        <li>
                                            <label class="black-text" for="id_wed{{ obj.pk }}">
                                                <input class="with-gap" type="radio" name="wedstrijd" value="wed_{{ obj.pk }}" id="id_wed{{ obj.pk }}"{% if wedstrijd_pk == obj.pk %} checked{% endif %}>
                                                <span>{{ obj.titel }}{% if obj.plaats %} ({{ obj.plaats }}){% endif %}</span>
                                            </label>
                                        </li>
                                    {% endfor %}

                                    <li>
                                        <label class="black-text" for="id_wed_geen">
                                            <input class="with-gap" type="radio" name="wedstrijd" value="geen" id="id_wed_geen"{% if wedstrijd_pk == 'geen' %} checked{% endif %}>
                                            <span>(geen van deze)</span>
                                        </label>
                                    </li>
                                </ul>
                            </td>
                        </tr>

                        <tr>
                            <th>Of vul deze velden in:</th>
                            <td>
                                <div class="input-field">
                                    <label for="invoer_plaats">Plaats</label>
                                    <input id="invoer_plaats" name="plaats" type="text" maxlength="30" value="{{ plaats }}">
                                </div>
                                <br>
                                <div class="input-field">
                                    <label for="invoer_land">Land</label>
                                    <input id="invoer_land" name="land" type="text" maxlength="30" value="{{ land }}">
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="center">
                                <!-- TODO: disable button todat alle invoer gegeven is -->
                                <button class="btn-sv-rood" id="submit_knop" type="submit">Volgende stap</button>
                            </td>
                        </tr>

                    </table>
                </form>
            </div>
        </div>
    </div>


    <p class="center">
        {% sv-knop-nav url=url_stap2 icon='terug' tekst='Terug naar stap 2' kleur='blauw' %}
    </p>

    {% include 'feedback/sidebar.dtl' with op_pagina="spelden-bestel-stap3" %}

{% endblock %}
